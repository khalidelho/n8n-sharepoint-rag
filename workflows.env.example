# Copy to workflows.env and fill in, then:  python3 scripts/configure_workflows.py
#
# Your SharePoint site's Graph ID: "<host>,<site-collection-id>,<web-id>". Get it from
#   GET https://graph.microsoft.com/v1.0/sites/<tenant>.sharepoint.com:/sites/<site-path>?$select=id
# (Graph Explorer works), e.g.  contoso.sharepoint.com,1111aaaa-...,2222bbbb-...
SHAREPOINT_SITE_ID=
# e.g. contoso.sharepoint.com
SHAREPOINT_HOST=
# the part after /sites/ in the site URL, e.g. KnowledgeBase
SITE_PATH=
# ID of the document library (a list GUID). Get it from
#   GET https://graph.microsoft.com/v1.0/sites/<SHAREPOINT_SITE_ID>/lists?$select=id,displayName
# or leave it blank and pick the library in the "SharePoint – get timestamps" node after import.
SHAREPOINT_LIST_ID=
# your Azure AI Foundry resource host, e.g. <resource>.services.ai.azure.com
AZURE_AI_HOST=
# Telegram chat that receives the daily health message (message your bot, then read getUpdates)
TELEGRAM_CHAT_ID=
