# Copy to vision/.env (chmod 600). Read by service.py and pages.py at start-up.
# Embedding model: gemma (EmbeddingGemma 2, 768-d; the bake-off winner) | vdr (1536-d) | qwen (2048-d).
# Must match the dims sql/04_page_views.sql was run with.
VISION_MODEL=gemma
# The service's own Postgres login (created by sql/04_page_views.sql), through Supabase's pooler on the host.
PG_DSN=postgresql://rag_vision.<POOLER_TENANT_ID>:<password>@localhost:5432/postgres
# Optional. Where rendered page images and the original files are kept (defaults: vision/pages/library, vision/sources).
PAGES_DIR=
SOURCES_DIR=
# Optional. Port on 127.0.0.1 (default 18500).
VISION_PORT=
# Optional shared secret. If you set it, add an `x-vision-token` header to every n8n HTTP node that calls the service.
VISION_TOKEN=
