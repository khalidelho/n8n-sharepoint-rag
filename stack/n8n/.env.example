# Copy to .env (same folder) and fill in. Generate random values with:  openssl rand -hex 24
N8N_DB_PASSWORD=
# Must never change once set — it encrypts every credential stored in n8n
N8N_ENCRYPTION_KEY=
# Password for the agent's read-only Postgres login (used by sql/02_agent_access.sql)
RAG_READER_PASSWORD=
# Shared secret between the Open WebUI pipe and the n8n chat webhook
RAG_WEBHOOK_TOKEN=
